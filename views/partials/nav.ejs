<nav class="sidebar" id="sidebar">
  <a href="/feed" class="logo">Pr<span class="logo-dot">i</span>sm</a>

  <div class="nav-links">
    <a href="/feed" class="nav-link <%= title === 'Feed' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Feed
    </a>
    <a href="/profile" class="nav-link <%= title === 'My Profile' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      Profile
    </a>
    <a href="/chat" class="nav-link <%= title === 'Messages' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
      Messages
    </a>
    <button class="nav-link" id="newPostBtn" onclick="openModal('newPostModal')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      New Post
    </button>
  </div>

  <% if (currentUser) { %>
  <div style="margin-top:auto;">
    <a href="/profile" class="sidebar-user">
      <% if (currentUser.avatar) { %>
        <img src="/uploads/<%= currentUser.avatar %>" alt="" class="sidebar-avatar" />
      <% } else { %>
        <div class="sidebar-avatar" style="display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.875rem;background:var(--accent)"><%= currentUser.username[0].toUpperCase() %></div>
      <% } %>
      <div>
        <div class="sidebar-username"><%= currentUser.username %></div>
        <div class="sidebar-handle">View profile</div>
      </div>
    </a>
    <form action="/logout" method="POST" style="margin-top:8px;">
      <button class="nav-link btn-ghost" style="width:100%;color:var(--danger);" type="submit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </button>
    </form>
  </div>
  <% } %>
</nav>

<!-- Mobile header -->
<header class="mobile-header">
  <button onclick="document.getElementById('sidebar').classList.toggle('open')"
    style="background:none;border:none;color:var(--text);font-size:1.25rem;cursor:pointer;padding:8px;">☰</button>
  <span style="font-family:var(--font-display);font-size:1.25rem;margin:0 auto;">Prism</span>
  <button onclick="openModal('newPostModal')"
    style="background:none;border:none;color:var(--accent);font-size:1.5rem;cursor:pointer;padding:8px;">+</button>
</header>
